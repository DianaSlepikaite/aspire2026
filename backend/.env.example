# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_api_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_MAX_TOKENS=4096
AZURE_OPENAI_TEMPERATURE=0.7

# Azure Speech Service Configuration
AZURE_SPEECH_KEY=your_speech_key_here
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_LANGUAGE=en-US
AZURE_SPEECH_VOICE_NAME=en-US-JennyNeural

# PostgreSQL Configuration (client_need_service)
# Use DATABASE_URL or individual DB_* variables
DATABASE_URL=
# Or: DB_HOST=localhost DB_PORT=5432 DB_NAME=client_needs_db DB_USER=postgres DB_PASSWORD=



# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Conversation Settings
MAX_CONVERSATION_MESSAGES=50
CONVERSATION_TIMEOUT_MINUTES=30
MIN_PROFILE_COMPLETENESS_FOR_COMPLETION=70

# Feature Flags
ENABLE_SPEECH_TO_TEXT=true
ENABLE_TEXT_TO_SPEECH=true
ENABLE_STREAMING_RESPONSES=false

# Storage Configuration
AUDIO_STORAGE_PATH=/tmp/audio
MAX_AUDIO_FILE_SIZE_MB=10

# ---------------------------------------------------------------------------
# Employee Conversation Service (port 8001) - PostgreSQL
# ---------------------------------------------------------------------------
# Option 1: Separate database on same Postgres (recommended)
#   Create DB: CREATE DATABASE employee_conversation_db;
#   Run schema: backend/employee_conversation_service/schema.sql in that DB
#   Then set (reuse host/user/pass from client):
# EMPLOYEE_DB_NAME=employee_conversation_db
# EMPLOYEE_DB_HOST=your_host
# EMPLOYEE_DB_PORT=5432
# EMPLOYEE_DB_USER=postgres
# EMPLOYEE_DB_PASSWORD=your_password

# Option 2: Same database as client (client_needs_db)
#   Run schema: backend/employee_conversation_service/schema.sql in client_needs_db
#   Then set:
# EMPLOYEE_DB_NAME=client_needs_db
# (EMPLOYEE_DB_HOST/USER/PASSWORD default to DB_HOST/DB_USER/DB_PASSWORD if unset)

# Option 3: Full URL for employee DB
# EMPLOYEE_DATABASE_URL=postgresql://user:pass@host:port/employee_conversation_db
